VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings -> API Keys -> Publishable key (starts with sb_publishable_).
# Older projects can still use the legacy anon key here, but the Edge Function
# gateway rejects it once a project has moved to the new API keys.
# Never put the secret key (sb_secret_...) or service_role key in this file.
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key
